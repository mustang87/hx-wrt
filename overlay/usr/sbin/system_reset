#!/bin/sh
# HX-WRT system_reset: unified reset entry (soft/hard)
# - soft: keep /mnt/etc, wipe runtime dirs next boot
# - hard: wipe /mnt/etc too (factory)
# Trigger file is created under /overlay, then preinit(79_hx_disk_ready) wipes on raw ubifs (/mnt).

set -eu

if [ -f /usr/lib/hxwrt/log.sh ]; then
	. /usr/lib/hxwrt/log.sh
	hx_log_init "reset" "reset.log"
	hx_log I "system_reset start: argv='$*'"
else
	hx_log() { :; }
	hx_log_kmsg() { :; }
fi

MODE="soft"
ASSUME_Y=0
DO_REBOOT=0

usage() {
	cat <<'EOF'
Usage:
  system_reset [--soft|--hard] [-y] [-r]
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--soft) MODE="soft" ;;
		--hard) MODE="hard" ;;
		-y) ASSUME_Y=1 ;;
		-r) DO_REBOOT=1 ;;
		-h|--help) usage; exit 0 ;;
		*) echo "Unknown arg: $1" >&2; usage; exit 1 ;;
	esac
	shift
done

confirm() {
	[ "$ASSUME_Y" -eq 1 ] && return 0
	echo -n "Proceed with ${MODE} reset? [y/N] "
	read -r ans
	[ "${ans:-}" = "y" ] || [ "${ans:-}" = "Y" ]
}

is_overlay_ready() {
	# allow either: root overlayfs, or /overlay mounted ubifs (normal runtime)
	mount | grep -qE '^overlayfs:/overlay on / ' && return 0
	mount | grep -qE ' on /overlay ' && return 0
	return 1
}

mark_extroot_wipe() {
	is_overlay_ready || {
		hx_log E "overlay not ready; cannot mark extroot wipe"
		echo "ERROR: overlay not ready; cannot mark extroot wipe." >&2
		exit 2
	}

	case "$MODE" in
		soft) : > /overlay/.extroot-erase-soft ;;
		hard) : > /overlay/.extroot-erase-hard ;;
	esac
	sync
	hx_log I "reset flag created (mode=$MODE)"
	hx_log_kmsg "reset flag created (mode=$MODE)"
}

confirm || { hx_log W "user aborted"; exit 0; }

mark_extroot_wipe

if [ "$DO_REBOOT" -eq 1 ]; then
	hx_log I "rebooting..."
	sync
	reboot
fi

hx_log I "done (mode=$MODE reboot=$DO_REBOOT)"
exit 0
