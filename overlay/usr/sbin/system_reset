#!/bin/sh
# HX-WRT system_reset: unified reset entry
#
# New architecture:
# - /overlay stays on system flash, so reset uses standard OpenWrt firstboot.
# - optional: --wipe-data can wipe data disk (/mnt/hx-data) as well.

set -eu

MODE="factory"
WIPE_DATA=0
ASSUME_Y=0
DO_REBOOT=0

usage() {
	cat <<'EOF'
Usage:
  system_reset [--factory] [--wipe-data] [-y] [-r]

Options:
  --factory     factory reset via firstboot (default)
  --wipe-data   also wipe /mnt/hx-data/openclash (core/geo/rule_provider/state)
  -y            assume yes
  -r            reboot after reset
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--factory) MODE="factory" ;;
		--wipe-data) WIPE_DATA=1 ;;
		-y) ASSUME_Y=1 ;;
		-r) DO_REBOOT=1 ;;
		-h|--help) usage; exit 0 ;;
		*) echo "Unknown arg: $1" >&2; usage; exit 1 ;;
	esac
	shift
done

confirm() {
	[ "$ASSUME_Y" -eq 1 ] && return 0
	echo -n "Proceed with ${MODE} reset? [y/N] "
	read -r ans
	[ "${ans:-}" = "y" ] || [ "${ans:-}" = "Y" ]
}

wipe_data_disk() {
	if grep -qs " /mnt/hx-data " /proc/mounts; then
		rm -rf /mnt/hx-data/openclash/core \
		       /mnt/hx-data/openclash/geo \
		       /mnt/hx-data/openclash/rule_provider \
		       /mnt/hx-data/openclash/state 2>/dev/null || true
		mkdir -p /mnt/hx-data/openclash/core \
		         /mnt/hx-data/openclash/geo \
		         /mnt/hx-data/openclash/rule_provider \
		         /mnt/hx-data/openclash/state 2>/dev/null || true
		sync
	else
		echo "WARN: /mnt/hx-data not mounted, skip wipe-data" >&2
	fi
}

confirm || exit 0

if [ "$WIPE_DATA" -eq 1 ]; then
	wipe_data_disk
fi

if command -v firstboot >/dev/null 2>&1; then
	firstboot -y
fi

sync

if [ "$DO_REBOOT" -eq 1 ]; then
	reboot
fi

exit 0
