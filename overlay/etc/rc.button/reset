#!/bin/sh
# HX-WRT reset button handler
# - short press: reboot
# - long press (>=5s): factory reset (firstboot -y && reboot)
#
# New storage architecture: NO extroot overlay, so do not depend on extroot wipe flags.

if [ -f /usr/lib/hxwrt/log.sh ]; then
  . /usr/lib/hxwrt/log.sh
  hx_log_init "button-reset" "button-reset.log"
else
  hx_log() { :; }
fi

. /lib/functions.sh

case "$ACTION" in
  pressed)
    return 5
    ;;
  released)
    if [ "${SEEN:-0}" -lt 1 ]; then
      hx_log I "short press -> reboot"
      echo "HX-WRT: REBOOT" > /dev/console
      sync
      reboot
      return 0
    fi

    if [ "${SEEN:-0}" -ge 5 ]; then
      hx_log W "long press -> factory reset (firstboot)"
      echo "HX-WRT: FACTORY RESET" > /dev/console
      if command -v firstboot >/dev/null 2>&1; then
        firstboot -y
      fi
      sync
      reboot &
      return 0
    fi
    ;;
esac

return 0
