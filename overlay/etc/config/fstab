config global 'automount'
	option anon_mount '1'
	option anon_swap '0'
	option auto_mount '1'
	option auto_swap '0'
	option delay_root '5'
	option check_fs '0'

# HX-WRT: built-in extroot overlay on the 2nd UBI partition (mtd5: "ubi1")
config mount 'extroot_overlay'
        option target '/overlay'
        option device 'ubi1:extroot_overlay'
        option uuid '810d086f-a669-4b02-ab72-debd1175a632'
        option fstype 'ubifs'
        option options 'rw,noatime'
        option enabled '1'
        option is_rootfs '1'
