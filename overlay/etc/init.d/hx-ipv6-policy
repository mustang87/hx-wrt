#!/bin/sh /etc/rc.common
START=12
STOP=90

TAG="hx-ipv6-policy"

log() { logger -t "$TAG" "$*"; }

apply_ipv6_disable() {
  # Network level
  uci set network.lan.delegate='0'
  uci set network.wan.delegate='0'
  uci -q delete network.wan6
  uci -q delete network.globals.ula_prefix
  uci set network.lan.ipv6='0' 2>/dev/null || true
  uci set network.wan.ipv6='0' 2>/dev/null || true
  uci commit network

  # DHCP / RA
  uci set dhcp.lan.ra='disabled'
  uci set dhcp.lan.dhcpv6='disabled'
  uci -q delete dhcp.lan.dhcpv6
  uci set dhcp.@dnsmasq[0].filter_aaaa='1'
  uci commit dhcp

  # odhcpd config + service
  uci -q set odhcpd.@odhcpd[0].maindhcp='0'
  uci -q set odhcpd.@odhcpd[0].ra='disabled'
  uci -q set odhcpd.@odhcpd[0].dhcpv6='disabled'
  uci commit odhcpd

  /etc/init.d/odhcpd stop >/dev/null 2>&1 || true
  /etc/init.d/odhcpd disable >/dev/null 2>&1 || true
}

start() {
  local enabled
  enabled="$(uci -q get hxwrt.ipv6_disable.enabled || echo 1)"
  [ "$enabled" = "1" ] || return 0

  apply_ipv6_disable
  log "IPv6 disabled (policy enforced)"
  return 0
}
