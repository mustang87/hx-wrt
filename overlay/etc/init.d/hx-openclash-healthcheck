#!/bin/sh /etc/rc.common
START=20
STOP=10
USE_PROCD=1

NAME="hx-openclash-healthcheck"
PROG="/usr/bin/hx-openclash-healthcheck"

start_service() {
  [ -x "$PROG" ] || return 0

  procd_open_instance
  procd_set_param command /bin/sh -c "sleep 10; $PROG"
  # Run periodically; avoid tight respawn loop
  # respawn: <threshold> <timeout> <retry>
  # Restart every 10 minutes if it exits quickly.
  procd_set_param respawn 3600 600 0
  procd_close_instance
}

stop_service() {
  return 0
}
