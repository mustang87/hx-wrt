config global 'automount'
	option anon_mount '0'
	option anon_swap '0'
	option auto_mount '0'
	option auto_swap '0'
	option delay_root '5'
	option check_fs '0'

config mount 'hxdata'
	option target '/mnt/hx-data'
	option device 'ubi1:hx_data'
	option fstype 'ubifs'
	option options 'rw,noatime'
	option enabled '1'
