#!/bin/sh /etc/rc.common
START=02
STOP=98

USE_PROCD=1

start_service() {
  . /usr/lib/hxwrt/log.sh

  # init stage
  hx_log_init "init" "boot.log"

  # If overlay is ready now, promote early logs into persistent storage
  if mount | grep -qE ' on /overlay '; then
    hx_log I "overlay mounted, promoting preinit logs to persistent dir"
    hx_log_promote
    hx_log_rotate
    hx_log I "bootlog init done (persist_dir=/overlay/hx/log)"
  else
    hx_log W "overlay not mounted yet at init stage; keep logging to tmp"
  fi
}
