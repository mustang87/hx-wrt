#!/bin/sh
# HX-WRT system_reset: unified reset entry (soft/hard)
# - soft: wipe extroot overlay runtime dirs on next boot (via 79_hx_disk_ready)
# - hard: same mechanism (currently identical), reserved for future "deeper wipe"
#
# Logs:
#   /overlay/hx/log/reset.log (or /tmp/.hxwrt/boot.log before overlay ready)

set -eu

# logging
if [ -f /usr/lib/hxwrt/log.sh ]; then
	. /usr/lib/hxwrt/log.sh
	hx_log_init "reset" "reset.log"
	hx_log I "system_reset start: argv='$*'"
else
	hx_log() { :; }
	hx_log_kmsg() { :; }
fi

MODE="soft"
ASSUME_Y=0
DO_REBOOT=0

usage() {
	cat <<'EOF'
Usage:
  system_reset [--soft|--hard] [-y] [-r]

Options:
  --soft        Soft reset: mark extroot overlay for runtime wipe on next boot (default)
  --hard        Hard reset: mark extroot overlay for runtime wipe on next boot
  -y            Assume yes (no prompt)
  -r            Reboot after marking reset
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--soft) MODE="soft" ;;
		--hard) MODE="hard" ;;
		-y) ASSUME_Y=1 ;;
		-r) DO_REBOOT=1 ;;
		-h|--help) usage; exit 0 ;;
		*)
			echo "Unknown arg: $1" >&2
			usage
			exit 1
			;;
	esac
	shift
done

confirm() {
	[ "$ASSUME_Y" -eq 1 ] && return 0
	echo -n "Proceed with ${MODE} reset? [y/N] "
	read -r ans
	[ "${ans:-}" = "y" ] || [ "${ans:-}" = "Y" ]
}

is_overlay_ready() {
	# root is overlayfs (upper on /overlay)
	mount | grep -qE '^overlayfs:/overlay on / '
}

mark_extroot_wipe() {
	is_overlay_ready || {
		hx_log E "overlayfs not mounted; cannot mark extroot wipe"
		echo "ERROR: overlayfs not mounted; cannot mark extroot wipe." >&2
		exit 2
	}

	# Create flag for preinit wipe policy (handled in 79_hx_disk_ready via /mnt mount)
	touch /overlay/.extroot-erase
	sync
	hx_log I "reset flag created: /overlay/.extroot-erase (mode=$MODE)"
	hx_log_kmsg "reset flag created (mode=$MODE)"
}

if ! confirm; then
	hx_log W "user aborted"
	exit 0
fi

case "$MODE" in
	soft)
		hx_log I "soft reset requested -> mark extroot wipe"
		mark_extroot_wipe
		;;
	hard)
		hx_log I "hard reset requested -> mark extroot wipe"
		mark_extroot_wipe
		;;
	*)
		hx_log E "invalid mode=$MODE"
		echo "BUG: invalid mode=$MODE" >&2
		exit 9
		;;
esac

if [ "$DO_REBOOT" -eq 1 ]; then
	hx_log I "rebooting..."
	sync
	reboot
fi

hx_log I "done (mode=$MODE reboot=$DO_REBOOT)"
exit 0
